[Unit]
Description=FS PBX bounded photo compression
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=/opt/fspbx-photo-worker/venv/bin/python /opt/fspbx-photo-worker/worker.py
RuntimeDirectory=fspbx-photo-compression
RuntimeDirectoryMode=0750
StateDirectory=fspbx-photo-compression
StateDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=1
MemoryMax=256M
MemorySwapMax=0
OOMPolicy=kill
CPUQuota=100%
TasksMax=32
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LimitFSIZE=64M
Environment=PYTHONDONTWRITEBYTECODE=1 VIPS_CONCURRENCY=1 OMP_NUM_THREADS=1 VIPS_BLOCK_UNTRUSTED=1

[Install]
WantedBy=multi-user.target
